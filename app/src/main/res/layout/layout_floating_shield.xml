<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floatingRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    android:background="@drawable/bg_floating_shield"
    android:elevation="12dp"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top Row: Icon + Brand + Dismiss -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivShieldIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_shield"
            app:tint="@color/primary_cyan" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="VOICE CLONE SHIELD"
            android:textColor="@color/primary_cyan"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDismiss"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/text_muted"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Caller Info -->
    <TextView
        android:id="@+id/tvCallerNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="+1 (412) 754-7405"
        android:textColor="@color/text_white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Live Analysis Status Banner -->
    <LinearLayout
        android:id="@+id/bannerStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#33EF4444"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivAlertStatus"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_warning"
            app:tint="@color/accent_red" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvThreatLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HIGH RISK: AI VOICE DETECTED"
                android:textColor="@color/accent_red"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvThreatDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="96% Synthetic Confidence • Spoof Artifacts Found"
                android:textColor="@color/text_white"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Audio Waveform / Realtime Status -->
    <TextView
        android:id="@+id/tvLiveStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="● Streaming Audio to Neural Classifier..."
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnHangupCall"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:backgroundTint="@color/accent_red"
            android:text="End Call"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSafeword"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/primary_blue"
            android:text="Verify Safeword"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
